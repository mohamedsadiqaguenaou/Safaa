# This file provides common configuration information for building
# chromium-browser packages for various platforms.

# Base name of the package.
PACKAGE="safaa-browser"

# Filename of the main executable (for generating launcher scripts, etc.)
PROGNAME=safaa

# Base directory for package installation.
INSTALLDIR=/opt/safaa/safaa-browser

# Directory for device policy enrollments.
ENROLLMENTDIR=/etc/safaa/policies/enrollment

# Display string for desktop menu/icon.
MENUNAME="Safaa Browser"

# Brief package description.
SHORTDESC="A privacy-focused web browser"

# Detailed package description.
FULLDESC="A privacy-focused, Muslim web browser with built-in background music removal (NoMusic), ad and tracker blocking (Shields), and always-on pornography and adult content blocking."

# Package maintainer information.
MAINTNAME="Safaa Browser"
MAINTMAIL="mohamedsadiqaguenaou@users.noreply.github.com"
PRODUCTURL="https://safaabrowser.com/"

RDN="com.safaa.browser"
