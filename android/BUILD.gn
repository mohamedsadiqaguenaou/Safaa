import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")
import("//brave/components/email_aliases/buildflags/buildflags.gni")
import(
    "//brave/components/policy/resources/templates/policy_definitions/brave_policies.gni")
import("//brave/components/webcompat_reporter/buildflags/buildflags.gni")
import("//build/config/android/rules.gni")

declare_args() {
  brave_android_developer_options_code = ""
}

java_cpp_template("brave_config_java") {
  sources = [ "//brave/build/android/java/templates/BraveConfig.template" ]
  defines = [
    "BRAVE_ANDROID_DEVELOPER_OPTIONS_CODE=\"$brave_android_developer_options_code\"",
    "BRAVE_ANDROID_WEBCOMPAT_REPORT_ENDPOINT=\"$webcompat_report_api_endpoint\"",
    "BRAVE_ANDROID_ENABLE_EMAIL_ALIASES=$enable_email_aliases",
  ]
}

# Generate Java constants from policy YAML files
# This target generates a srcjar that is consumed by chrome_java via srcjar_deps
# Using action_with_pydeps like upstream does
action_with_pydeps("brave_policy_constants_java_srcjar") {
  script = "//brave/tools/generate_policy_constants_java.py"

  # Collect all YAML policy files as inputs (excluding .group.details.yaml)
  _policy_yaml_inputs = []
  foreach(policy_file, brave_policies) {
    if (policy_file != "BraveSoftware/.group.details.yaml") {
      _policy_yaml_inputs += [ "//brave/components/policy/resources/templates/policy_definitions/$policy_file" ]
    }
  }

  # List files explicitly so GN tracks them for incremental builds
  inputs = _policy_yaml_inputs
  outputs = [ "$target_gen_dir/$target_name.srcjar" ]
  args = [
    "--policy-dir",
    rebase_path(
        "//brave/components/policy/resources/templates/policy_definitions/BraveSoftware",
        root_build_dir),
    "--output-srcjar",
    rebase_path("$target_gen_dir/$target_name.srcjar", root_build_dir),
  ]
}

android_library("qrreader_java") {
  sources = [
    "java/org/chromium/chrome/browser/qrreader/BarcodeTracker.java",
    "java/org/chromium/chrome/browser/qrreader/BarcodeTrackerFactory.java",
    "java/org/chromium/chrome/browser/qrreader/CameraSource.java",
    "java/org/chromium/chrome/browser/qrreader/CameraSourcePreview.java",
    "java/org/chromium/chrome/browser/qrreader/QRCodeCameraManager.java",
  ]

  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/android_deps:google_play_services_base_java",
    "//third_party/android_deps:google_play_services_vision_common_java",
    "//third_party/android_deps:google_play_services_vision_java",
    "//third_party/androidx:androidx_activity_activity_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
  ]
}

android_library("settings_insets_java") {
  sources = [
    "java/org/chromium/chrome/browser/settings/BottomInsetViewProvider.java",
  ]
  deps = [ "//build/android:build_java" ]
}

