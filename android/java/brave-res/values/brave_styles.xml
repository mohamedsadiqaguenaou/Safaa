<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 sheet theme for the rating prompts. Unlike AppBottomSheetDialogTheme this is a
         ThemeOverlay rather than a full theme, so the host activity's attributes - including the
         dynamic color overlay - resolve through it. The default Widget.Material3.BottomSheet.Modal
         paints the container with ?attr/colorSurfaceContainerLow, so the sheets do not carry their
         own background. -->
    <style name="RatingBottomSheetDialogTheme"
           parent="ThemeOverlay.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="AppSetDefaultBottomSheetDialogTheme"
           parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalSetDefaultStyle</item>
    </style>

    <style name="AppModalSetDefaultStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/rounded_set_default_top_corners</item>
    </style>

    <!-- Brave Wallet -->

    <style name="BraveWalletInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <!-- Border color. -->
        <item name="boxStrokeColor">@color/wallet_onboarding_input_field_stroke_color</item>
        <!-- Hint text color that translates to the top of the view. -->
        <item name="hintTextColor">@color/text_primary</item>
        <!-- Blinking cursor color. -->
        <item name="cursorColor">@color/icon_interactive</item>
        <!-- Blinking cursor color on error state. -->
        <item name="cursorErrorColor">@color/system_feedback_error</item>
    </style>

    <style name="BookmarkTabPopupMenu" parent="Theme.AppCompat.DayNight">
        <item name="android:textColor">@color/bookmark_menu_text_color</item>
        <item name="android:popupBackground">@drawable/bookmark_menu_bg</item>
        <item name="android:popupElevation">20dp</item>
        <item name="android:popupMenuStyle">@drawable/bookmark_menu_bg</item>
    </style>

    <style name="NewTabPopupMenuLight" parent="Widget.AppCompat.PopupMenu">
      <item name="android:textColor">@android:color/black</item>
      <item name="android:itemBackground">@android:color/white</item>
    </style>

    <style name="NewTabPopupMenuDark" parent="Widget.AppCompat.PopupMenu">
      <item name="android:textColor">@color/new_tab_menu_text_dark_color</item>
      <item name="android:itemBackground">@color/new_tab_menu_bg_dark_color</item>
    </style>

    <!-- Toolbar for the Install VPN profile screen. Background and text follow
         the page theme (light/dark) instead of the legacy purple. -->

    <!-- Theme for the Install VPN profile activity. Colors the status and
         navigation bars to match the page surface, following the upstream
         settings pattern (theme-level statusBarColor/navigationBarColor with the
         shared window_light_* bools for icon contrast). -->
    <style
        name="Theme.Brave.VpnProfile"
        parent="Theme.Chromium.Activity"
        tools:ignore="UnusedResources">
        <item name="android:statusBarColor">@color/schemes_surface_container</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:navigationBarColor">@color/schemes_surface_container</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
    </style>

    <!-- Brave account -->

    <style name="BottomSheetAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="BraveAccountTheme" parent="Theme.Chromium.Activity.Fullscreen">
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
    </style>

    <!-- Brave Shields -->
    <style name="BraveShieldsBlockCookieModeText" parent="DefaultRegular">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Suggestions tiles -->
    <style name="BraveSuggestionsTilesText"
           parent="TextAppearance.TextSmall.Secondary">
        <item name="android:textColor">
            @color/brave_state_time_count_color</item>
    </style>

    <!-- Nala tokens styles  -->

    <style name="DefaultRegular">
        <!-- Default Brave UI size -->
        <item name="android:textSize">@dimen/default_regular</item>
        <item name="lineHeight">20sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="SmallRegular">
        <item name="android:textSize">@dimen/small_regular</item>
        <item name="lineHeight">16sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="SmallSemibold">
        <!--
            TODO(alexeybarabash, Deep, Agustin) Shold we ambed this font?
            Otherwise, app can't be built:
            error: resource font/roboto (aka com.brave.browser_default:font/roboto) not found.
        -->
        <!-- <item name="android:fontFamily">@font/roboto</item> -->
        <item name="android:textSize">@dimen/small_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">16sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">600</item>
    </style>

    <style name="LargeRegular">
        <!-- Default browser size for fonts -->
        <item name="android:textSize">@dimen/large_regular</item>
        <item name="lineHeight">24sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="TextAppearance.Brave.PreferenceTitle.TextButton"
           parent="TextAppearance.TextLarge.Primary">
        <item name="android:textColor">?attr/globalTextButtonTextColor</item>
    </style>

    <style name="TextAppearance.Brave.PreferenceTitle.DestructiveAction"
           parent="TextAppearance.TextLarge.Primary">
        <item name="android:textColor">@color/systemfeedback_error_text</item>
    </style>

    <style name="LargeSemibold">
        <!-- Default browser size for fonts -->
        <item name="android:textSize">@dimen/large_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">24sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">600</item>
    </style>

    <style name="ComponentsButtonDefault">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="lineHeight">20sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">600</item>
    </style>

    <style name="DefaultSemibold">
        <!-- Default Brave UI size -->
        <item name="android:textSize">@dimen/default_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">20sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">600</item>
    </style>

    <style name="HeadingH1">
        <item name="android:textSize">@dimen/heading_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">40sp</item>
        <item name="fontStyle">normal</item>
    </style>

    <style name="HeadingH2">
        <item name="android:textSize">@dimen/heading_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">30sp</item>
        <item name="fontStyle">normal</item>
    </style>

    <style name="HeadingH3">
        <item name="android:textSize">@dimen/heading_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">28sp</item>
        <item name="fontStyle">normal</item>
    </style>

    <style name="HeadingH4">
        <item name="android:textSize">@dimen/heading_h4</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">24sp</item>
        <item name="fontStyle">normal</item>
    </style>

    <style name="FontHeadingDisplay2">
        <item name="android:textSize">40sp</item>
        <item name="android:fontWeight">600</item>
        <item name="lineHeight">48sp</item>
        <item name="fontStyle">normal</item>
    </style>

    <style name="IncognitoNtpTitle" parent="HeadingH1"/>

    <style name="IncognitoNtpSectionTitle" parent="DefaultSemibold"/>

    <style name="IncognitoNtpSectionDescription" parent="SmallRegular"/>

  <style name="MonospaceSmall">
    <item name="android:textSize">@dimen/monospace_small</item>
    <item name="lineHeight">16sp</item>
    <item name="fontStyle">normal</item>
    <item name="fontWeight">400</item>
    <!--
        Use default monospace font instead of spec
        <item name="android:fontFamily">@font/roboto_mono</item>
        to avoid font embedding and save 83KB.
        When there will be more places where roboto_mono is used,
        then worth to embed and actually use roboto_mono.
    -->
    <item name="android:typeface">monospace</item>
  </style>

    <style name="FadeEnterAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/fast_fade_in</item>
    </style>

    <!--  Customized enter animation to provide a smooth transition between splash screen and
      welcome onboarding activity. -->
    <style name="Theme.Brave.WelcomeOnboarding" parent="Theme.Chromium.Activity.Fullscreen">
        <item name="android:windowAnimationStyle">@style/FadeEnterAnimation</item>
    </style>

    <!-- Button styles from Nala Universal design specs
    https://www.figma.com/design/g8Z0q6TMPYDq6zXh9Y7LWD/%F0%9F%8C%8E-Universal -->

    <style name="LargeButtonBase" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="LargeFilledButton" parent="LargeButtonBase">
        <item name="android:textColor">@color/schemes_on_primary</item>
        <item name="android:background">@drawable/button_full</item>
    </style>

    <style name="LargeOutlineButton" parent="LargeButtonBase">
        <item name="android:textColor">@color/text_interactive</item>
        <item name="android:background">@drawable/button_outline</item>
    </style>

    <style name="BraveCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/brave_checkbox_background_color_selector</item>
        <item name="buttonIconTint">@color/brave_checkbox_color_selector</item>
        <item name="android:textSize">@dimen/default_regular</item>
    </style>

    <style name="PreferenceCategory.NoTitle" parent="Preference.Category">
        <item name="android:layout">@layout/preference_category_no_title</item>
    </style>

    <style name="TextAppearance.BraveBlockedItemIcon" parent="TextAppearance.TextSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
