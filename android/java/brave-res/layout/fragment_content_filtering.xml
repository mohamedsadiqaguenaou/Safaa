<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical">

     <!-- The porn blocker cannot be turned off, so the switch is on and disabled. -->
     <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/porn_blocker"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <TextView
               android:id="@+id/porn_blocker_title"
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toStartOf="@id/porn_blocker_switch"
               android:layout_marginTop="14dp"
               android:layout_marginHorizontal="16dp"
               android:text="@string/porn_blocker_title"
               android:textStyle="bold"
               android:textSize="16sp"
               android:textColor="@color/filter_title_color"/>

          <TextView
               android:id="@+id/porn_blocker_summary"
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               app:layout_constraintTop_toBottomOf="@id/porn_blocker_title"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toStartOf="@id/porn_blocker_switch"
               android:layout_marginTop="2dp"
               android:layout_marginHorizontal="16dp"
               android:text="@string/porn_blocker_summary"
               android:textSize="14sp"
               android:textColor="@color/filter_summary_color"/>

          <com.google.android.material.materialswitch.MaterialSwitch
               android:id="@+id/porn_blocker_switch"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent"
               app:layout_constraintEnd_toEndOf="parent"
               android:layout_marginEnd="16dp"
               android:checked="true"
               android:enabled="false"/>

          <View
               android:layout_width="match_parent"
               android:layout_height="1dp"
               app:layout_constraintTop_toBottomOf="@id/porn_blocker_summary"
               android:layout_marginTop="12dp"
               android:background="?attr/colorOutline"/>

     </androidx.constraintlayout.widget.ConstraintLayout>

     <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recyclerview"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:overScrollMode="never" />

</LinearLayout>
